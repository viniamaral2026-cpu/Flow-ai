# src/modules/recipes.py - roda no Ubuntu do usuário

from playwright.sync_api import sync_playwright

def search_recipe(query, trusted_sites, ask_permission=True):
    if ask_permission:
        # Flow pergunta igual Meta AI: "Quer que eu acesse o navegador e busque?"
        speak("Encontrei 15 sites confiáveis. Quer que eu acesse o navegador e busque receita de " + query + " pra você?")
        if not user_said_yes(): return
    
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=False) # usuário vê abrindo
        page = browser.new_page()
        
        results = []
        for site in trusted_sites[:3]: # busca nos 3 primeiros pra ser rápido
            page.goto(f"{site['url']}{query}")
            # Extrai só título, tempo, link - NÃO copia ingredientes inteiros
            title = page.locator("h2.recipe-title").first.text_content()
            time = page.locator(".time").first.text_content()
            link = page.locator("a.recipe").first.get_attribute("href")
            results.append({"source": site['name'], "title": title, "time": time, "link": link})
        
        # Entrega pra Flow
        return results

